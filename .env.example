# 複製成 .env 後填入。正式環境的值放在 EC2 上，不進 git。
DATABASE_URL="postgresql://dagi:dagi@localhost:5434/dagi?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# GA4 評估 ID（只有前台會載入）
NEXT_PUBLIC_GA_ID=""

# ───── 後台第一個管理員（只給 npm run db:seed 用；建好後可以從 .env 移除）─────
# 帳號已存在時會把密碼重設成 ADMIN_PASSWORD。密碼至少 10 個字元，不要用預設值。
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# 選填，預設「管理員」
ADMIN_NAME=""

# ───── 圖片儲存 ─────
# local（預設）：存在專案根目錄 storage/uploads/，由 /media/... 提供；Docker 部署要把這個資料夾掛成 volume
# s3：存到 AWS S3（尚未實測）
STORAGE_DRIVER=""
# 選填：local 模式改存到別的資料夾（絕對路徑）
STORAGE_LOCAL_DIR=""
# s3 模式必填
S3_BUCKET=""
S3_REGION=""
# 前台讀圖的公開網址，例：https://<bucket>.s3.<region>.amazonaws.com 或 CloudFront 網址
S3_PUBLIC_BASE_URL=""
# 選填：物件路徑前綴，例 uploads/
S3_KEY_PREFIX=""
# 選填：EC2 建議用 IAM Role，不填就走 AWS 預設憑證鏈
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# 選填：S3 相容服務才需要
S3_ENDPOINT=""
